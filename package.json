{
  "name": "togurumiweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "sheets:auth": "tsx server/scripts/sheets-auth.ts",
    "users:bootstrap": "tsx server/persistence/bootstrapUsers.ts",
    "persistence:import": "tsx server/persistence/importLegacy.ts",
    "db:migrate": "tsx server/persistence/migrate.ts",
    "test:persistence": "tsx --test server/persistence/*.test.ts",
    "test:users": "tsx --test server/persistence/postgresUserStore.test.ts",
    "test:sessions": "tsx --test server/persistence/redisSessionStore.test.ts",
    "test:rate-limits": "tsx --test server/persistence/rateLimitStore.test.ts",
    "test:reviews": "tsx --test server/persistence/postgresReviewStore.test.ts",
    "test:content": "tsx --test server/persistence/postgresContentStores.test.ts",
    "test:journal": "tsx --test server/persistence/postgresJournalStore.test.ts server/persistence/journalClient.test.ts",
    "test:checkout": "tsx --test server/checkout.test.ts server/sheetsRoute.test.ts server/shopPrice.test.ts server/shopStock.test.ts server/shipping.test.ts server/stripe.test.ts server/stripeWebhook.test.ts server/persistence/postgresOrderStore.test.ts",
    "test:refunds": "tsx --test server/refunds.test.ts server/refundNotify.test.ts server/persistence/postgresRefundStore.test.ts",
    "test:vercel": "tsx --test server/vercel.test.ts",
    "test:colors": "tsx --test src/lib/shop.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.7.0",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.2",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true
  }
}
