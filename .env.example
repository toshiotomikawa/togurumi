# Seed accounts created explicitly with: npm run users:bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD=change-me-to-a-long-random-password

# Required on Vercel/in production. Leave blank only for local development,
# where the JSON/Markdown stores remain available.
DATABASE_URL=

# Signs session cookies and hashes session keys on disk (data/sessions.json).
# Quote the value if it contains # (otherwise dotenv treats # as a comment).
SESSION_SECRET="change-me-to-a-long-random-string"
API_PORT=8788

# Required on Vercel/in production. Set both values to use Upstash Redis;
# leave both blank only to keep local session/rate-limit stores in development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL — the domain visitors use (NOT localhost in production).
# Used for OAuth redirects and secure session cookies.
APP_URL=http://localhost:5174

# Extra origins allowed for login/save API calls (comma-separated). Add your
# LAN IP and/or public IP with port when sharing the dev server, e.g.:
# LAN_APP_URL=http://192.0.2.100:5174,http://203.0.113.10:5174
LAN_APP_URL=

# Optional Google OAuth (leave blank until configured; the login button stays
# visible but disabled until both values below are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/api/auth/google/callback

# Optional Google Sheets integration (private spreadsheet, read via OAuth2
# using your own Google account — leave blank to disable; the staff-only GET /api/sheets/:tab
# returns 503 until set). Run `npm run sheets:auth` to get the refresh token.
# Google Sheets integration (private spreadsheet):
# PREFERRED (PERMANENT): Google Cloud Service Account (keys never expire).
# Share the Google Sheet with the Service Account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=

# ALTERNATIVE (LEGACY): OAuth2 Refresh Token (expires after 7 days in Testing mode).
GOOGLE_SHEETS_OAUTH_CLIENT_ID=
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_CACHE_TTL_MS=60000

# Product image uploads used by /admin/products. Find both values in the
# ImageKit dashboard under Developer options, then restart the API. The private
# key is server-only: keep it in .env and never expose it through a VITE_ name.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/togurumi
IMAGEKIT_PRIVATE_KEY=

# Stripe Checkout (shop payments). Leave blank to keep checkout disabled:
# POST /api/checkout and the webhook answer 503 until both keys are set.
# Use test-mode keys (sk_test_...) locally and in Preview; live keys only in
# Production. The secret key and webhook secret are server-only: never give
# them a VITE_ name. See docs/stripe.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Not required: the site redirects to Stripe-hosted Checkout, so no Stripe.js
# key is loaded in the browser. Only set it if Stripe.js is added later.
VITE_STRIPE_PUBLISHABLE_KEY=

# SuperFrete shipping (optional). Leave blank to keep the current checkout
# without shipping. The integration itself is free; each label is paid.
# Use the sandbox token during development. These values are server-only.
SUPERFRETE_ENV=sandbox
SUPERFRETE_TOKEN=
SUPERFRETE_ORIGIN_CEP=
SUPERFRETE_CONTACT_EMAIL=
SHIPPING_SERVICES=1,2,17
# Blank uses the official 29-municipality RMC list (AMEP).
SHIPPING_SERVED_CITIES=
SHIPPING_PICKUP_ADDRESS=
# Grams added once per order to the summed piece weight; PESO_G is the piece without packaging.
SHIPPING_PACKAGING_WEIGHT_G=50
SHIPPING_INSURANCE_MIN_SUBTOTAL_CENTS=6000
SHIPPING_FALLBACK_CENTS=

# Address used for the Checkout success/cancel redirects. Falls back to
# APP_URL when blank. No trailing slash.
PUBLIC_SITE_URL=http://localhost:5174

# Refund requests (/reembolso). Both values are optional: without them the
# site keeps working and the request only reaches the admin list at
# /admin/refunds. RESEND_API_KEY is a Resend API key and REFUND_NOTIFY_EMAIL is
# the inbox that receives each new request. REFUND_EMAIL_FROM must be a sender
# verified in Resend; leave it blank to test with onboarding@resend.dev, which
# only delivers to the Resend account owner. See docs/refunds.md.
RESEND_API_KEY=
REFUND_NOTIFY_EMAIL=
REFUND_EMAIL_FROM=
