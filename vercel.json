{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/frete-superfrete": false
    }
  },
  "installCommand": "npm ci",
  "devCommand": "npm run dev:web",
  "redirects": [
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!api/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
